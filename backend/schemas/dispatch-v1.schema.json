{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intelifluxo:local:dispatch:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "eventId"],
  "properties": {
    "version": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  }
}
