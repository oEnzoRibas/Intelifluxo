{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "automation-list-v1",
  "definitions": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?=[\\s\\S]*\\S)(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*(?![\\s\\S])"
        },
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=[\\s\\S]*\\S)(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*(?![\\s\\S])"
        },
        "active": {
          "enum": ["true", "false"]
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]?|100)(?![\\s\\S])"
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "scope",
              "active",
              "revision",
              "schemaVersion",
              "workflowVersion"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^(?=[\\s\\S]*\\S)(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*(?![\\s\\S])"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?=[\\s\\S]*\\S)(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*(?![\\s\\S])"
              },
              "active": {
                "type": "boolean"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "schemaVersion": {
                "enum": [1, 2]
              },
              "workflowVersion": {
                "enum": [1, 2]
              }
            }
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
