{
  "name": "intelifluxo-local-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "api": "tsx src/api-main.ts",
    "relay": "tsx src/relay-main.ts",
    "scheduler": "tsx src/scheduler-main.ts",
    "demo:retry": "tsx scripts/retry-demo.ts",
    "demo:integrated": "tsx scripts/integrated-demo.ts",
    "worker": "tsx src/worker-main.ts",
    "test": "vitest run",
    "test:integration": "vitest run test/integration.test.ts test/scheduler.integration.test.ts test/automations.integration.test.ts test/executions.integration.test.ts test/graph.integration.test.ts test/conditions-migration.integration.test.ts test/conditions-api.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "demo:automation": "tsx scripts/automation-demo.ts"
  },
  "dependencies": {
    "amqplib": "2.3.0",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/amqplib": "0.10.8",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
